{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": ".site",
    "binding": "ASSETS",
    "run_worker_first": ["/orbitcraft/socket", "/orbitcraft/health"]
  },
  "durable_objects": { "bindings": [{ "name": "ORBITCRAFT_WORLD", "class_name": "OrbitcraftWorld" }] },
  "migrations": [{ "tag": "orbitcraft-v1", "new_sqlite_classes": ["OrbitcraftWorld"] }],
  "observability": { "enabled": true }
}
