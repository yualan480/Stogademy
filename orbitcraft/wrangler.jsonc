{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study",
  "main": "cloudflare/worker.js",
  "build": { "command": "node -e \"const fs=require('node:fs'); import(fs.existsSync('cloudflare/build.js') ? './cloudflare/build.js' : './orbitcraft/cloudflare/build.js');\"" },
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": ".site",
    "binding": "ASSETS",
    "run_worker_first": ["/pokemon-showdown/action", "/orbitcraft/socket", "/orbitcraft/health", "/orbit-intelligence/socket", "/orbit-intelligence/health"]
  },
  "durable_objects": { "bindings": [{ "name": "ORBITCRAFT_WORLD", "class_name": "OrbitcraftWorld" }, { "name": "ORBIT_INTELLIGENCE", "class_name": "OrbitIntelligence" }] },
  "migrations": [{ "tag": "orbitcraft-v1", "new_sqlite_classes": ["OrbitcraftWorld"] }, { "tag": "orbit-intelligence-v1", "new_sqlite_classes": ["OrbitIntelligence"] }],
  "observability": { "enabled": true }
}
